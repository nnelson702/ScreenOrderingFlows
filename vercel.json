{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://screen-ordering-api.nnelson.workers.dev/api/:path*"
    },
    {
      "source": "/staff",
      "destination": "/staff.html"
    },
    {
      "source": "/quote",
      "destination": "/quote.html"
    }
  ],
  "headers": [
    {
      "source": "/staff",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
    },
    {
      "source": "/staff.html",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
    },
    {
      "source": "/quote",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
    },
    {
      "source": "/quote.html",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
    },
    {
      "source": "/api/:path*",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
    }
  ]
}
